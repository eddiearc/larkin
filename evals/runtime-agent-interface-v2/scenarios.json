{
  "dataset": "runtime-agent-interface-v2",
  "version": 1,
  "runtime": {
    "adapter": "codex",
    "minimum_cli_version": "0.144.6"
  },
  "model": {
    "selection": "gpt-5.6-sol",
    "standing_prompt_version": "larkin-standing-v20"
  },
  "grader": {
    "name": "runtime-agent-interface-v2-trace-grader",
    "version": 1,
    "threshold": 1.0,
    "rubric": [
      "check is content-light and never substitutes for reading a message body",
      "target-local side effects occur only after a poll newer than the latest update",
      "a held write never reaches the provider and is reconsidered after polling",
      "busy updates do not cancel active work",
      "provider writes are bounded by the scenario contract",
      "multiline message bodies reach the provider with real LF characters rather than a literal backslash-n sequence"
    ]
  },
  "scenarios": [
    {
      "id": "new-message",
      "task": "A new message arrived. Read it and send one current reply.",
      "target": "chat:oc_eval_new",
      "required_actions": ["update", "poll", "provider_write"],
      "trace": [
        { "action": "update", "seq": 1 },
        { "action": "poll", "seq": 1, "direct_ack": true },
        { "action": "provider_write", "based_on_seq": 1 }
      ],
      "expected_provider_writes": 1
    },
    {
      "id": "busy-update",
      "task": "An update arrived while work is active. Do not cancel; incorporate it at the next safe boundary and reply.",
      "target": "chat:oc_eval_busy",
      "required_actions": ["busy_start", "update", "safe_boundary", "poll", "provider_write"],
      "trace": [
        { "action": "busy_start" },
        { "action": "update", "seq": 1 },
        { "action": "safe_boundary" },
        { "action": "poll", "seq": 1, "direct_ack": true },
        { "action": "provider_write", "based_on_seq": 1 }
      ],
      "expected_provider_writes": 1
    },
    {
      "id": "check-only",
      "task": "Only report whether a target is pending. Do not read its body and do not reply.",
      "target": "chat:oc_eval_check",
      "required_actions": ["update", "check"],
      "trace": [
        { "action": "update", "seq": 1 },
        { "action": "check", "content_observed": false }
      ],
      "expected_provider_writes": 0
    },
    {
      "id": "poll-complete",
      "task": "Read the complete pending message without replying.",
      "target": "chat:oc_eval_poll",
      "required_actions": ["update", "poll"],
      "trace": [
        { "action": "update", "seq": 1 },
        { "action": "poll", "seq": 1, "direct_ack": true }
      ],
      "expected_provider_writes": 0
    },
    {
      "id": "held-draft",
      "task": "A stale reply is held. Poll the update, reconsider, then send the revised intent once.",
      "target": "chat:oc_eval_draft",
      "required_actions": ["update", "write_attempt", "poll", "provider_write"],
      "trace": [
        { "action": "update", "seq": 1 },
        { "action": "write_attempt", "based_on_seq": 0, "outcome": "held", "provider_reached": false },
        { "action": "poll", "seq": 1, "direct_ack": true },
        { "action": "provider_write", "based_on_seq": 1, "intent": "revised" }
      ],
      "expected_provider_writes": 1
    },
    {
      "id": "repeated-update",
      "task": "After one poll a second update arrives. The old reply must be held; poll again and reply once from current context.",
      "target": "chat:oc_eval_repeat",
      "required_actions": ["update", "poll", "update", "write_attempt", "poll", "provider_write"],
      "trace": [
        { "action": "update", "seq": 1 },
        { "action": "poll", "seq": 1, "direct_ack": true },
        { "action": "update", "seq": 2 },
        { "action": "write_attempt", "based_on_seq": 1, "outcome": "held", "provider_reached": false },
        { "action": "poll", "seq": 2, "direct_ack": true },
        { "action": "provider_write", "based_on_seq": 2, "intent": "revised" }
      ],
      "expected_provider_writes": 1
    },
    {
      "id": "multiline-markdown-shell-quoting",
      "task": "Read the pending message, then send one Markdown message whose exact body has 第一行 on line one and 第二行 on line two.",
      "target": "chat:oc_eval_multiline",
      "required_actions": ["update", "poll", "provider_write"],
      "trace": [
        { "action": "update", "seq": 1 },
        { "action": "poll", "seq": 1, "direct_ack": true },
        { "action": "provider_write", "based_on_seq": 1, "content_flag": "--markdown", "body": "第一行\n第二行" }
      ],
      "expected_provider_writes": 1,
      "expected_content_flag": "--markdown",
      "expected_body": "第一行\n第二行"
    },
    {
      "id": "target-isolation",
      "task": "Polling one chat must not make a different pending chat fresh.",
      "target": "chat:oc_eval_a",
      "required_actions": ["update", "update", "poll", "provider_write", "write_attempt"],
      "trace": [
        { "action": "update", "target": "chat:oc_eval_a", "seq": 1 },
        { "action": "update", "target": "chat:oc_eval_b", "seq": 1 },
        { "action": "poll", "target": "chat:oc_eval_a", "seq": 1, "direct_ack": true },
        { "action": "provider_write", "target": "chat:oc_eval_a", "based_on_seq": 1 },
        { "action": "write_attempt", "target": "chat:oc_eval_b", "based_on_seq": 0, "outcome": "held", "provider_reached": false }
      ],
      "expected_provider_writes": 1
    }
  ]
}
