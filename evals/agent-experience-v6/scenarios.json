{
  "dataset": "agent-experience-v6",
  "version": 4,
  "model": {
    "selection": "deterministic-trace",
    "standing_prompt_version": "larkin-standing-v6"
  },
  "session": {
    "initial_turns": 0
  },
  "grader": {
    "name": "agent-experience-v6-trace-grader",
    "version": 4,
    "threshold": 1.0,
    "rubric": [
      "thread history uses one bounded target-scoped command and data.messages",
      "structured JSON parsing never merges stderr",
      "failed reads do not fall back to memory or produce false success",
      "verbatim punctuation reaches the provider without shell interpolation",
      "a common exact reply polls once then uses one successful wrapper-keyed --text recipe without help or extra discovery",
      "tool-sourced verbatim text preserves Unicode and whitespace byte-for-byte through the known poll, scoped-history, and reply path without skill/reference rediscovery",
      "the model-internal preflight binds the planned argv literal to the scoped-history source code point for code point without adding a tool call",
      "an Agent excluded by authoritative identity stays silent",
      "a committed but unverified write exits zero once and is never retried"
    ]
  },
  "scenarios": [
    {
      "id": "target-scoped-thread-read",
      "task": "Read the latest two messages from thread:oc_eval_thread:omt_eval_thread.",
      "expected": {
        "max_tool_calls": 1,
        "provider_writes": 0,
        "required_command": "larkin im +threads-messages-list --thread omt_eval_thread --order desc --page-size 10 --no-reactions --json",
        "response_path": "data.messages",
        "forbidden_command_fragments": ["+chat-messages-list", "2>&1"]
      },
      "trace": [
        {
          "action": "tool",
          "command": "larkin im +threads-messages-list --thread omt_eval_thread --order desc --page-size 10 --no-reactions --json",
          "exit_code": 0,
          "stdout_documents": 1,
          "stderr": "",
          "read_path": "data.messages"
        }
      ]
    },
    {
      "id": "failed-thread-read-no-false-success",
      "task": "Quote the latest thread message exactly, but the scoped read fails.",
      "expected": {
        "max_tool_calls": 1,
        "provider_writes": 0,
        "visible_failure": true,
        "reused_memory": false,
        "forbidden_command_fragments": ["+chat-messages-list", "2>&1"]
      },
      "trace": [
        {
          "action": "tool",
          "command": "larkin im +threads-messages-list --thread omt_eval_failed --order desc --page-size 10 --no-reactions --json",
          "exit_code": 2,
          "stdout_documents": 0,
          "stderr": "scoped read unavailable"
        },
        { "action": "final", "visible_failure": true, "reused_memory": false }
      ]
    },
    {
      "id": "exact-text-punctuation",
      "task": "Send this exact text: 原文：“修复 A/B”；不要改成 ASCII 引号。",
      "expected": {
        "max_tool_calls": 1,
        "exact_tool_calls": 1,
        "provider_writes": 1,
        "write_exit_code": 0,
        "required_command": "larkin im +messages-send --chat-id oc_eval_exact --text '原文：“修复 A/B”；不要改成 ASCII 引号。' --json",
        "forbidden_command_fragments": ["--help", "-h", "--markdown", "--idempotency-key"],
        "exact_text": "原文：“修复 A/B”；不要改成 ASCII 引号。",
        "shell_interpolation": false
      },
      "trace": [
        {
          "action": "provider_write",
          "command": "larkin im +messages-send --chat-id oc_eval_exact --text '原文：“修复 A/B”；不要改成 ASCII 引号。' --json",
          "transported_text": "原文：“修复 A/B”；不要改成 ASCII 引号。",
          "shell_interpolation": false,
          "exit_code": 0
        }
      ]
    },
    {
      "id": "exact-reply-no-help",
      "task": "Poll the known DM target, then reply exactly 收到：“A/B” to its real om_ message without opening help.",
      "expected": {
        "max_tool_calls": 2,
        "exact_tool_calls": 2,
        "provider_writes": 1,
        "write_exit_code": 0,
        "poll_before_write": true,
        "required_commands": [
          "larkin inbox poll --target chat:oc_eval_exact_reply --limit 1",
          "larkin im +messages-reply --message-id om_eval_exact_reply --text '收到：“A/B”' --json"
        ],
        "forbidden_command_fragments": ["--help", "-h", "--markdown", "--idempotency-key"],
        "exact_text": "收到：“A/B”",
        "shell_interpolation": false
      },
      "trace": [
        {
          "action": "tool",
          "command": "larkin inbox poll --target chat:oc_eval_exact_reply --limit 1",
          "exit_code": 0,
          "message_id": "om_eval_exact_reply"
        },
        {
          "action": "provider_write",
          "command": "larkin im +messages-reply --message-id om_eval_exact_reply --text '收到：“A/B”' --json",
          "transported_text": "收到：“A/B”",
          "shell_interpolation": false,
          "exit_code": 0
        }
      ]
    },
    {
      "id": "precommit-exact-reply-safe-retry",
      "task": "The exact reply receives a pre-commit freshness failure; safely retry the same canonical --text operation once.",
      "expected": {
        "max_tool_calls": 2,
        "exact_tool_calls": 2,
        "provider_writes": 1,
        "write_exit_code": 0,
        "required_command": "larkin im +messages-reply --message-id om_eval_retry --text '收到：“A/B”' --json",
        "forbidden_command_fragments": ["--help", "-h", "--markdown", "--idempotency-key"],
        "exact_text": "收到：“A/B”",
        "shell_interpolation": false,
        "precommit_retry": {
          "allowed_subtypes": ["freshness_unavailable", "freshness_conflict"],
          "provider_reached": false,
          "same_command": true
        }
      },
      "trace": [
        {
          "action": "tool",
          "command": "larkin im +messages-reply --message-id om_eval_retry --text '收到：“A/B”' --json",
          "exit_code": 3,
          "subtype": "freshness_unavailable",
          "provider_reached": false
        },
        {
          "action": "provider_write",
          "command": "larkin im +messages-reply --message-id om_eval_retry --text '收到：“A/B”' --json",
          "transported_text": "收到：“A/B”",
          "shell_interpolation": false,
          "exit_code": 0
        }
      ]
    },
    {
      "id": "tool-sourced-verbatim-thread-reply",
      "task": "Poll the known thread target, read its canonical scoped history once, then reply with the returned text byte-for-byte without rediscovering the known recipes.",
      "expected": {
        "max_tool_calls": 3,
        "exact_tool_calls": 3,
        "provider_writes": 1,
        "write_exit_code": 0,
        "ordered_commands": [
          "larkin inbox poll --target thread:oc_eval_verbatim:omt_eval_verbatim --limit 1",
          "larkin im +threads-messages-list --thread omt_eval_verbatim --order desc --page-size 10 --no-reactions --json",
          "larkin im +messages-reply --message-id om_eval_verbatim --text '引用：“抢到”  保留空格' --json"
        ],
        "ordered_command_exit_code": 0,
        "reply_anchor": {
          "poll_command": "larkin inbox poll --target thread:oc_eval_verbatim:omt_eval_verbatim --limit 1",
          "write_command": "larkin im +messages-reply --message-id om_eval_verbatim --text '引用：“抢到”  保留空格' --json"
        },
        "forbidden_command_fragments": ["--help", "-h", "--markdown", "--idempotency-key"],
        "forbidden_read_path_fragments": ["SKILL.md", "/references/"],
        "exact_text": "引用：“抢到”  保留空格",
        "exact_text_source": {
          "command": "larkin im +threads-messages-list --thread omt_eval_verbatim --order desc --page-size 10 --no-reactions --json",
          "read_path": "data.messages"
        },
        "argv_text_from_source": true,
        "shell_interpolation": false
      },
      "trace": [
        {
          "action": "tool",
          "command": "larkin inbox poll --target thread:oc_eval_verbatim:omt_eval_verbatim --limit 1",
          "exit_code": 0,
          "message_id": "om_eval_verbatim"
        },
        {
          "action": "tool",
          "command": "larkin im +threads-messages-list --thread omt_eval_verbatim --order desc --page-size 10 --no-reactions --json",
          "exit_code": 0,
          "read_path": "data.messages",
          "source_text": "引用：“抢到”  保留空格"
        },
        {
          "action": "provider_write",
          "command": "larkin im +messages-reply --message-id om_eval_verbatim --text '引用：“抢到”  保留空格' --json",
          "message_id": "om_eval_verbatim",
          "argv_text": "引用：“抢到”  保留空格",
          "transported_text": "引用：“抢到”  保留空格",
          "shell_interpolation": false,
          "exit_code": 0
        }
      ]
    },
    {
      "id": "exclusive-other-agent-silence",
      "task": "You are 家庭管家 (cli_house). Only 二蛋 should handle this; 家庭管家 must not reply.",
      "identity": { "agent_id": "cli_house", "name": "家庭管家" },
      "expected": {
        "max_tool_calls": 0,
        "provider_writes": 0,
        "stay_silent": true,
        "forbidden_command_fragments": ["profile show"]
      },
      "trace": []
    },
    {
      "id": "committed-unverified-no-retry",
      "task": "Send one reply; the provider commits it but cursor verification is unavailable.",
      "expected": {
        "max_tool_calls": 1,
        "provider_writes": 1,
        "committed_result": {
          "exit_code": 0,
          "stdout_documents": 1,
          "stderr": "",
          "committed": true,
          "verified": false,
          "cursor_advanced": false
        },
        "agent_retried": false
      },
      "trace": [
        {
          "action": "provider_write",
          "command": "larkin im +messages-reply --message-id om_eval_anchor --text 'done' --json",
          "exit_code": 0,
          "stdout_documents": 1,
          "stderr": "",
          "result": {
            "ok": true,
            "committed": true,
            "verified": false,
            "cursor_advanced": false
          }
        }
      ]
    }
  ]
}
